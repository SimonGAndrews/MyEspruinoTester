{
  "metadataVersion": 1,
  "board": "ESP32",
  "description": "Generic ESP32 DevKit harness profile for Espruino testing",
  "upstream": {
    "id": "ESP32",
    "binary": "espruino_%v_esp32.bin",
    "localJSON": "../cliBoardFiles/ESP32.json"
  },
  "firmware": {
    "pattern": "espruino_%v_esp32.bin",
    "artifacts": [
      { "name": "bootloader", "filename": "bootloader.bin", "offset": "0x0" },
      { "name": "partitions", "filename": "partition-table.bin", "offset": "0x8000" },
      { "name": "application", "filename": "%pattern%", "offset": "0x10000" }
    ]
  },
  "flash": {
    "type": "esp32-esptool",
    "chip": "esp32",
    "baud": 921600,
    "mode": "dio",
    "freq": "40m",
    "extraArgs": [
      "--before",
      "default_reset",
      "--after",
      "hard_reset"
    ]
  },
  "suites": {
    "default": [
      "javascript-core",
      "library-xfsm"  
    ],
    "available": [
      "javascript-core",
      "library-xfsm",
      "hardware-io",
      "wifi-connectivity",
      "wifi-ap",
      "javascript-upstream",
      "runner-metadata",
      "basicAsync"
    ]
  }
}
