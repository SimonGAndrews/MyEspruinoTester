{
  "metadataVersion": 1,
  "board": "ESP32C3_IDF4",
  "description": "ESP32-C3 USB/serial harness profile for Espruino testing",
  "upstream": {
    "id": "ESP32C3_IDF4",
    "binary": "espruino_%v_esp32c3.bin"
  },
  "localJSON": "../cliBoardFiles/ESP32C3_IDF4.json",
  "firmware": {
    "pattern": "espruino_%v_esp32c3.bin",
    "artifacts": [
      {
        "name": "bootloader",
        "filename": "bootloader.bin",
        "offset": "0x0"
      },
      {
        "name": "partitions",
        "filename": "partition-table.bin",
        "offset": "0x8000"
      },
      {
        "name": "application",
        "filename": "%pattern%",
        "offset": "0x10000"
      }
    ]
  },
  "flash": {
    "type": "esp32-esptool",
    "chip": "esp32c3",
    "baud": 460800,
    "mode": "dio",
    "freq": "80m",
    "extraArgs": [
      "--before",
      "usb_reset",
      "--after",
      "hard_reset"
    ],
    "_notes_reset": "Default uses USB Serial-JTAG (usb_reset). For UART DTR/RTS, set extraArgs to ['--before','default_reset','--after','hard_reset'] and use /dev/ttyUSB*."
  },
  "suites": {
    "default": [
      "javascript-core",
      "wifi-core",
      "wifi-station"
    ],
    "available": [
      "javascript-core",
      "javascript-upstream",
      "flash-storage",
      "wifi-core",
      "wifi-station",
      "wifi-http-client",
      "wifi-http-server",
      "wifi-mqtt-ws",
      "wifi-ap",
      "wifi-config-diagnostics",
      "basicAsync",
      "runner-metadata"
    ]
  }
}
